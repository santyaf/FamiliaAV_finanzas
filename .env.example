# =========================================================
# FINANZAS DEL HOGAR — variables de entorno
# =========================================================
# Copia este archivo a `.env.local` para desarrollo:
#     cp .env.example .env.local
# y luego reemplaza cada valor de ejemplo por el real.
#
# En producción NO se usa este archivo: cada variable se
# configura en Vercel → Settings → Environment Variables.
# Este archivo solo documenta CUÁLES existen y para qué sirven;
# nunca debe contener valores reales (el repo es público).
#
# Reglas rápidas:
#   - Prefijo VITE_  → se compila dentro del bundle y queda
#     visible en el navegador. NO pongas secretos aquí.
#   - Sin prefijo    → solo vive en el servidor (funciones /api
#     y el cron de recordatorios). Aquí van los secretos.
# =========================================================


# ---------- Supabase (obligatorio) ----------
# Supabase → Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...tu-anon-key-publica...

# service_role key — Supabase → Settings → API → "service_role".
# Salta RLS por diseño: SOLO servidor. NUNCA la pongas con prefijo VITE_.
# La usa api/send-reminders.js para leer recordatorios de todos los usuarios.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...tu-service-role-secreta...


# ---------- IA para el "Registro rápido" (opcional) ----------
# Solo necesitas la clave del proveedor que realmente vayas a usar.
# Si falta la de un proveedor, la app muestra un error claro al intentarlo
# y nada más se rompe.
ANTHROPIC_API_KEY=sk-ant-...          # Claude  — https://console.anthropic.com/settings/keys
OPENAI_API_KEY=sk-...                 # ChatGPT — https://platform.openai.com/api-keys
GOOGLE_API_KEY=AIza...                # Gemini  — https://aistudio.google.com/apikey


# ---------- Notificaciones push / recordatorios (Fase 9) ----------
# Genera TU propio par de claves VAPID (son gratis, un comando):
#     npx web-push generate-vapid-keys
# La pública va también con prefijo VITE_ (el navegador la necesita para suscribirse).
# La privada es secreta: solo servidor.
VITE_VAPID_PUBLIC_KEY=BJ...tu-clave-publica-vapid...
VAPID_PRIVATE_KEY=...tu-clave-privada-vapid...

# Clave compartida entre Vercel y el workflow de GitHub Actions que dispara
# el envío de recordatorios cada 5 min. Inventa una cadena larga y aleatoria:
#     openssl rand -base64 36
# El MISMO valor debe quedar en Vercel (env var) y en GitHub (Actions secret).
REMINDER_CRON_SECRET=cadena-larga-aleatoria


# ---------- Solo para el workflow de GitHub Actions ----------
# Estos NO van en Vercel ni en .env.local; se configuran en
# GitHub → repo → Settings → Secrets and variables → Actions:
#   VERCEL_APP_URL        = https://tuapp.vercel.app   (sin "/" al final)
#   REMINDER_CRON_SECRET  = el mismo valor de arriba
